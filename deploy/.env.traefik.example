NOVALIST_VERSION=1.0.0
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
POSTGRES_IMAGE=postgres:17.10-alpine

SYNC_DOMAIN=novalist-persist.qf0xb.de
OIDC_DOMAIN=novalist-persist-auth.qf0xb.de

# Existing shared Traefik network and its fixed IPv4 address on that network.
TRAEFIK_NETWORK=
TRAEFIK_IP=
# Match the names configured in your existing Traefik deployment.
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Leave empty only if Traefik already loads certificates without a resolver.
TRAEFIK_CERT_RESOLVER=letsencrypt

KEYCLOAK_ADMIN=bootstrap-admin
# Generate three independent secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
SYNC_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
