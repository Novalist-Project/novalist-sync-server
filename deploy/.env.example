# Replace with an existing published Novalist release (without the leading v).
NOVALIST_VERSION=1.0.0
CADDY_IMAGE=caddy:2.11.9-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
POSTGRES_IMAGE=postgres:17.10-alpine

# Both public DNS names must point directly at this host.
SYNC_DOMAIN=sync.example.com
OIDC_DOMAIN=identity.example.com
ACME_EMAIL=admin@example.com

# Choose a subnet that does not overlap your host, VPN or other Docker networks.
FRONTEND_SUBNET=172.30.60.0/24
PROXY_IP=172.30.60.2

KEYCLOAK_ADMIN=bootstrap-admin
# Generate independent secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Relay example only:
RELAY_CLIENT_SECRET=
# Persistent example only:
SYNC_DB_PASSWORD=
