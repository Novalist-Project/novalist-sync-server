NOVALIST_VERSION=1.0.0
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
POSTGRES_IMAGE=postgres:17.10-alpine

SYNC_DOMAIN=novalist-relay.qf0xb.de
OIDC_DOMAIN=novalist-relay-auth.qf0xb.de

# Existing shared Traefik network and its stable IPv4 address on that network.
TRAEFIK_NETWORK=
TRAEFIK_IP=
TRAEFIK_HTTPS_ENTRYPOINT=websecure
# Leave empty only if Traefik already loads certificates without a resolver.
TRAEFIK_CERT_RESOLVER=letsencrypt

KEYCLOAK_ADMIN=bootstrap-admin
# Generate three independent secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
RELAY_CLIENT_SECRET=
